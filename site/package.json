{
  "name": "product-design-skills-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for the skills in this repository, generated from the skill files with Fumadocs.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "content:watch": "node --watch-path=../skills --watch-path=../catalog --watch-path=../scripts/lib scripts/generate-content.mjs",
    "predev": "npm run content",
    "dev": "next dev",
    "prebuild": "npm run content",
    "build": "next build",
    "check:export": "node scripts/check-export.mjs",
    "preview": "node scripts/serve-export.mjs",
    "pretypecheck": "npm run content",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.15.9",
    "fumadocs-ui": "16.15.9",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
